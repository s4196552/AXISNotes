{
  "manifest_version": 3,
  "name": "AXIS Web Clipper",
  "version": "0.1.0",
  "description": "Save pages, selections, screenshots and links into your AXIS vault on this computer.",
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Clip to AXIS",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": {
    "gecko": { "id": "web-clipper@axis.local", "strict_min_version": "121.0" }
  }
}
